# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM provider API key (used by LiveKit inference)
OPENAI_API_KEY=

# TTS provider (pick one)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Deepgram STT
DEEPGRAM_API_KEY=

# Bey video avatar (Beyond Presence)
BEY_API_KEY=
BEY_AVATAR_ID=
BEY_AVATAR_ENABLED=true
# Optional: override Bey API URL (e.g. for dev environment)
# BEY_API_URL=

# LLM model override (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
